    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "vue": "^3.4.35",
    "vue-router": "^4.4.3",
    "vue-sonner": "^1.1.5",
    "webdav": "^5.8.0"
